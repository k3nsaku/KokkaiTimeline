---
/**
 * 頻出語のページ。月ごとの推移 + 発言一覧。
 *
 * グラフは `data/dist/frequent.json` だけで描けるので**ビルド時に SVG にする**
 * （`/topic/[id]` と同じ作り）。発言一覧だけがブラウザからのDB引き。
 *
 * ★ **検索の引き先を独自に持たない。** 2文字語は `word_hit`、3文字以上は FTS で、
 *   どちらに行くかは `resolveQuery()` が決める。ここで別扱いを足すと
 *   「絞り込みを3経路とも直す」の4つ目ができてしまう（CLAUDE.md）。
 *
 * ★ 争点語にもある語はここに来ない（一覧が `/topic/[id]` へ寄せている）。
 */
import Base from "../../layouts/Base.astro";
import { frequent, manifest } from "../../lib/site-data";
import { toSeries, monthlyChart } from "../../lib/chart";
import { formatNumber } from "../../lib/format";

export function getStaticPaths() {
  return frequent().words
    // 争点語ページがある語は二重に作らない
    .filter((word) => word.topic_id == null)
    .map((word) => ({ params: { term: word.term }, props: { word } }));
}

const { word } = Astro.props;
const data = frequent();
const periods = manifest().periods;

const series = toSeries(data.months, word.series, data.speech_totals);
const chart = monthlyChart(series, `${word.term} の月ごとの出現率`);
const peak = [...series].sort((a, b) => b.rate - a.rate)[0];

const description =
  `国会で「${word.term}」がいつ議論されたか。${formatNumber(word.n)}件の発言を` +
  `月ごとの出現率で見られます。`;
---

<Base title={`${word.term} の頻度推移`} description={description}>
  <p class="small"><a href="/frequent">← 頻出語の一覧</a></p>

  <h1>{word.term}</h1>
  <p class="small muted">
    {formatNumber(word.n)}件の発言に出てきます。
    会議録から機械的に抽出した語で、<strong><a href="/topics">争点語</a>ではありません</strong>
    （運営が選んだ語ではないという意味です）。
  </p>

  <section>
    <h2>いつ議論されたか</h2>
    <Fragment set:html={chart} />
    {peak && (
      <p class="small muted">
        最も多かったのは {peak.month.slice(0, 4)}年{Number(peak.month.slice(5, 7))}月
        （{peak.hits}件 / {formatNumber(peak.total)}発言 ＝ 1,000発言あたり {peak.rate.toFixed(1)}件）。
        ふつうの年の{word.burst.toFixed(1)}倍です。
      </p>
    )}
  </section>

  <section>
    <h2>この語を含む発言</h2>
    <p id="status" class="status" role="status" aria-live="polite">読み込み中…</p>
    <div id="results"></div>
    <p id="more-wrap" hidden><button id="more">さらに読み込む</button></p>
    <p class="small muted">
      条件を足して絞り込むなら<a href={`/search?q=${encodeURIComponent(word.term)}`}>検索</a>から
      どうぞ（会議名・年で絞れます）。
    </p>
  </section>

  <p class="small muted note">
    どの会派がよく使ったかは、この語では出していません。
    500語すべてに会派の内訳を持たせるとファイルが1.6MBになり、
    ページを開くたびに読ませることになるためです。
    会派ごとの使われ方は<a href="/topics">争点語</a>のページで見られます。
  </p>

  <script
    is:inline
    type="application/json"
    id="site-data"
    set:html={JSON.stringify({ term: word.term, periods })}
  />

  <script>
    import { search, resolveQuery, splitTerms, type QueryPlan } from "../../lib/db";
    import { renderSpeeches } from "../../lib/render";
    // 抜粋のクリックを横取りして本文パネルを出す（広い画面だけ）。
    // 狭い画面・JS無効では /speech/<id> へそのまま遷移する
    import { initSpeechPanel } from "../../lib/speech-panel";
    import { escapeHtml } from "../../lib/format";

    initSpeechPanel();

    const { term, periods } = JSON.parse(
      document.getElementById("site-data")!.textContent!,
    ) as { term: string; periods: string[] };

    const statusEl = document.getElementById("status")!;
    const results = document.getElementById("results")!;
    const moreWrap = document.getElementById("more-wrap") as HTMLParagraphElement;
    const moreBtn = document.getElementById("more") as HTMLButtonElement;

    let cursor: Record<string, number> | undefined;
    // ★ 引き先の判定は1回だけ。ページ送りでは使い回す（毎回引くと word を無駄に読む）
    let plan: QueryPlan | undefined;

    async function run(append: boolean) {
      const started = performance.now();
      try {
        plan ??= await resolveQuery(term, periods);
        const page = await search({
          query: term, plan, periods, limit: 20, before: append ? cursor : undefined,
        });
        cursor = page.before;
        results.insertAdjacentHTML("beforeend",
          renderSpeeches(page.rows, { terms: splitTerms(term), groupByYear: true }));
        moreWrap.hidden = page.done;
        statusEl.textContent = `新しい順・${Math.round(performance.now() - started)}ms`;
      } catch (err) {
        statusEl.innerHTML = `<span class="error">読み込みに失敗しました: ${escapeHtml(String(err))}</span>`;
        console.error(err);
      }
    }

    moreBtn.addEventListener("click", async () => {
      moreBtn.disabled = true;
      await run(true);
      moreBtn.disabled = false;
    });

    run(false);
  </script>

  <style>
    /* `.chart …` 一式と `.note` は Base.astro の共通定義（左罫の色が
       ページごとに割れていたのを1つにした） */
    .note { margin-top: 2.5rem; }
  </style>
</Base>
