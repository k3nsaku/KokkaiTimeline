---
/**
 * 検索。中身はすべてブラウザが期間DBから引くので、ここは骨組みだけ。
 *
 * 三段構え（`docs/DECISIONS.md`）:
 *   争点語リストにある語 → topic_hit を引く（0.7秒）
 *   2文字以下を含む語    → word_hit を引く（本文の2文字窓は全部索引にある）
 *   それ以外の任意語     → FTS5 trigram（1.5〜6秒）
 *
 * **絞り込みは年で見せる。** 配信DBは半期で割ってあるが、期間は年に閉じているので
 * 年 → 期間の変換で日付の取りこぼしが出ない（`lib/query.ts` の `periodsInYearRange`）。
 */
import Base from "../layouts/Base.astro";
import { manifest, topicSeries, politicians, latestAffiliation } from "../lib/site-data";
import { MAX_INPUT_LENGTH, yearsOfPeriods } from "../lib/query";
import { jsonScript } from "../lib/format";

const periods = manifest().periods;
const years = yearsOfPeriods(periods);
const series = topicSeries();
// 争点語は「その語なら速く引ける」判定に使うので、ページに埋め込んでおく（82件・数KB）。
// `indexed` は**配信済みの全期間DBがその語を持っているか**（`scripts/build_db.py` の
// `stamp_indexed()`）。偽なら topic_hit を引かず、普通の検索経路に落とす
const topics = series.topics.map((t) => ({
  id: t.id, term: t.term, variants: t.variants, indexed: t.indexed,
}));

// 月ごとの分母。**グラフを「1,000発言あたり」に切り替えたときだけ使う。**
// 全体は64か月ぶんの数値1本（約1KB）、会議名ごとは105会議×64か月（22KB・gzip 5KB）。
// ★ヒットは `speaker_kind='議員'` の索引から来るので、分母も議員の発言数で揃えてある
const trend = {
  months: series.months,
  totals: series.speech_totals["*"] ?? [],
  meetings: series.meeting_totals ?? {},
};

// 議員1,111人。**DBは引かない**（`lib/politician-search.ts` の冒頭）。
// 会派と院は同じ文字列の繰り返しなので、表に逃がして添字で持つ（そのままだと2倍近くなる）
const kaihaTable: string[] = [];
const houseTable: string[] = [];
const indexOf = (table: string[], value: string) => {
  const at = table.indexOf(value);
  return at >= 0 ? at : table.push(value) - 1;
};
const people = politicians().map((p) => {
  const a = latestAffiliation(p);
  return [
    p.id, p.name, p.name_kana ?? "",
    indexOf(kaihaTable, a?.kaiha ?? ""),
    indexOf(houseTable, p.house ?? ""),
    p.n_speeches,
  ] as const;
});
---

<Base title="検索" description="国会会議録の発言と議員をキーワードで検索できます。" noindex>
  <h1>検索</h1>

  <form id="search-form" class="search-form">
    <div class="row">
      <label class="grow">
        <span class="label">キーワード</span>
        {/* ★ 実際の上限は `canonicalQuery()` 側（URLは入力欄を通らない）。
            ここは打っている最中に気づけるようにするためだけのもの */}
        <input type="search" id="q" name="q" placeholder="例: 安全保障、選択的夫婦別姓、年金"
               autocomplete="off" enterkeyhint="search" maxlength={MAX_INPUT_LENGTH} />
      </label>
      <button type="submit" class="primary">検索</button>
    </div>

    {/* 引ける範囲の制限は**打つ前に**見えているのが望ましい。
        実際に引けない語を打たれたときは、結果欄でもう一度くわしく出す（run()）。 */}
    <p class="small muted">
      2文字以下の語は専用の索引で引くため、<strong>漢字だけ・カタカナだけ・英数字だけ</strong>の
      2文字（憲法・コロナ・ＡＩ）に限られます。「ため」のようなひらがなだけの2文字、
      「お金」「踏ま」のように文字種をまたぐ2文字、1文字だけの検索は引けません。
      <a href="/about">くわしく</a>
    </p>

    <details class="filters">
      <summary>絞り込み</summary>
      <div class="row">
        <label>
          <span class="label">会議名</span>
          <select id="meeting" name="meeting"><option value="">すべて</option></select>
        </label>
        <label>
          <span class="label">期間</span>
          <span class="range">
            <select id="from" name="from">
              {years.map((y) => <option value={y}>{y}年</option>)}
            </select>
            〜
            <select id="until" name="until">
              {years.map((y) => <option value={y} selected={y === years.at(-1)}>{y}年</option>)}
            </select>
          </span>
        </label>
      </div>
      <p class="small muted">
        期間は年単位で絞れます。期間ごとに別のデータベースを引く仕組みなので、
        年を減らすとそのぶん速くなります。
        <strong>この絞り込みは発言にだけ効きます</strong>（議員の検索には関係しません）。
      </p>
    </details>
  </form>

  {/* 発言と議員は引き先がまったく違う（年DB / ページに埋めた議員マスタ）ので、
      同じ結果欄に混ぜずにタブで分ける。既定は発言 */}
  <div class="tabs" role="tablist" aria-label="検索結果の種類">
    <button type="button" role="tab" id="tab-speeches" aria-controls="panel-speeches"
            aria-selected="true">発言<span class="tab-count" id="count-speeches"></span></button>
    <button type="button" role="tab" id="tab-people" aria-controls="panel-people"
            aria-selected="false" tabindex="-1">議員<span class="tab-count" id="count-people"></span></button>
  </div>

  <div id="panel-speeches" role="tabpanel" aria-labelledby="tab-speeches">
    <p id="status" class="status" role="status" aria-live="polite"></p>

    {/* 検索語の月ごとの推移。**件数はDBから引く**（`monthlyHits()`）が、
        「1,000発言あたり」に切り替えたときの分母はページに埋め込んである。
        0件のときと引けない語のときは丸ごと隠す */}
    <section id="trend" hidden>
      <h2>いつ議論されたか</h2>
      <fieldset class="trend-mode">
        <legend class="sr-only">グラフの縦軸</legend>
        <label><input type="radio" name="trend-mode" value="count" checked /> 件数</label>
        <label><input type="radio" name="trend-mode" value="rate" /> 1,000発言あたり</label>
      </fieldset>
      <div id="trend-chart"></div>
      <p id="trend-note" class="small muted" hidden></p>
    </section>

    <div id="results"></div>
    <p id="more-wrap" hidden><button id="more">さらに読み込む</button></p>
  </div>

  <div id="panel-people" role="tabpanel" aria-labelledby="tab-people" hidden>
    <p id="people-status" class="status" role="status" aria-live="polite"></p>
    <div id="people-results"></div>
  </div>

  {/* 年の一覧と争点語（82件・数KB）をページに埋めておく。
      争点語かどうかで引き先が変わる（topic_hit か FTS か）ので、検索の前に要る。
      議員1,111人ぶんも埋める（会派・院は表に逃がして添字で持つ） */}
  <script
    is:inline
    type="application/json"
    id="site-data"
    set:html={jsonScript({ years, periods, topics, people, kaihaTable, houseTable, trend })}
  />

  <script>
    import { search, countHits, monthlyHits, meetingNames, resolveQuery, splitTerms,
             canonicalQuery, toFullWidth, periodsInYearRange, unsearchableTerms,
             MAX_INPUT_LENGTH, MAX_URL_LENGTH, MAX_MEETING_LENGTH,
             type MonthlyPoint,
             type SearchOptions, type SearchPage, type QueryPlan } from "../lib/db";
    // **グラフはビルド時と同じ関数で描く**（争点語・頻出語のページと同じ `monthlyChart`）
    import { monthlyChart, toSeries, type MonthlyMode } from "../lib/chart";
    import { renderSpeeches } from "../lib/render";
    // 抜粋のクリックを横取りして本文パネルを出す（広い画面だけ）。
    // 狭い画面・JS無効では /speech/<id> へそのまま遷移する
    import { initSpeechPanel } from "../lib/speech-panel";
    import { matchPoliticians, type PoliticianLite } from "../lib/politician-search";
    import { describeError, escapeHtml, formatNumber } from "../lib/format";

    initSpeechPanel();

    interface TopicLite {
      id: number; term: string; variants: string[];
      /** 配信済みの全期間DBが持っているか。偽なら topic_hit を引けない */
      indexed: boolean;
    }
    type PackedPerson = [number, string, string, number, number, number];

    /** 月ごとの分母。**率に切り替えたときだけ使う**（件数のグラフには要らない） */
    interface TrendData {
      months: string[];
      /** `months` と同じ並びの、その月の議員発言数 */
      totals: number[];
      /** 会議名 → その会議の月ごとの発言数。会議名で絞ったときの分母 */
      meetings: Record<string, number[]>;
    }

    const { periods, topics, people: packed, kaihaTable, houseTable, trend } = JSON.parse(
      document.getElementById("site-data")!.textContent!,
    ) as {
      years: number[]; periods: string[]; topics: TopicLite[];
      people: PackedPerson[]; kaihaTable: string[]; houseTable: string[];
      trend: TrendData;
    };

    // 埋め込みは添字で持っているので、ここで戻す（1,111件・一度きり）
    const people: PoliticianLite[] = packed.map(([id, name, kana, k, h, n]) => ({
      id, name, kana, kaiha: kaihaTable[k] ?? "", house: houseTable[h] ?? "", n,
    }));

    const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
    const form = el<HTMLFormElement>("search-form");
    const queryInput = el<HTMLInputElement>("q");
    const meetingSelect = el<HTMLSelectElement>("meeting");
    const fromSelect = el<HTMLSelectElement>("from");
    const untilSelect = el<HTMLSelectElement>("until");
    const statusEl = el<HTMLParagraphElement>("status");
    const results = el<HTMLDivElement>("results");
    const moreWrap = el<HTMLParagraphElement>("more-wrap");
    const moreBtn = el<HTMLButtonElement>("more");

    // --- タブ ---------------------------------------------------------------
    //
    // 発言と議員は引き先が違う（年DB / ページに埋めた議員マスタ）。
    // **議員のほうは同期で決まる**ので、発言の結果を待たずに件数が出る。

    const tabSpeeches = el<HTMLButtonElement>("tab-speeches");
    const tabPeople = el<HTMLButtonElement>("tab-people");
    const panelSpeeches = el<HTMLDivElement>("panel-speeches");
    const panelPeople = el<HTMLDivElement>("panel-people");
    const peopleStatus = el<HTMLParagraphElement>("people-status");
    const peopleResults = el<HTMLDivElement>("people-results");

    /** 利用者が自分でタブを選んだか。**選んだあとは自動で切り替えない。**
     *  検索のたびに戻す（新しい問い合わせなら、また自動判定してよい） */
    let userPickedTab = false;
    let peopleCount = 0;

    function selectTab(which: "speeches" | "people") {
      const speeches = which === "speeches";
      tabSpeeches.setAttribute("aria-selected", String(speeches));
      tabPeople.setAttribute("aria-selected", String(!speeches));
      tabSpeeches.tabIndex = speeches ? 0 : -1;
      tabPeople.tabIndex = speeches ? -1 : 0;
      panelSpeeches.hidden = !speeches;
      panelPeople.hidden = speeches;
    }

    for (const [tab, which] of [[tabSpeeches, "speeches"], [tabPeople, "people"]] as const) {
      tab.addEventListener("click", () => { userPickedTab = true; selectTab(which); });
    }
    // 矢印キーでタブを移動できるようにする（role="tablist" の作法）
    for (const tab of [tabSpeeches, tabPeople]) {
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
        event.preventDefault();
        userPickedTab = true;
        const next = tab === tabSpeeches ? tabPeople : tabSpeeches;
        selectTab(next === tabSpeeches ? "speeches" : "people");
        next.focus();
      });
    }

    /**
     * どちらを見せるか決める。**片方にしか結果が無ければそちらを出す。**
     * 両方あるとき・どちらも無いときは発言（このサイトの主機能）。
     *
     * 発言の件数は非同期なので、**確定してから1回だけ**呼ぶ。
     */
    function autoSelectTab(speechHits: number) {
      if (userPickedTab) return;
      selectTab(speechHits === 0 && peopleCount > 0 ? "people" : "speeches");
    }

    function showPeople(query: string) {
      const rows = matchPoliticians(query, people);
      peopleCount = rows.length;
      el("count-people").textContent = rows.length ? ` ${rows.length}` : "";

      if (!rows.length) {
        peopleStatus.textContent = "一致する議員はいませんでした。";
        peopleResults.innerHTML = "";
        return;
      }
      peopleStatus.textContent =
        `${formatNumber(rows.length)}人${rows.length >= 60 ? "以上" : ""}`;
      peopleResults.innerHTML = `
        <div class="scroll-x">
          <table>
            <thead>
              <tr><th>氏名</th><th>院</th><th>会派</th><th class="num">発言数</th></tr>
            </thead>
            <tbody>${rows.map((r) => `
              <tr>
                <td>
                  <a href="/politician/${r.id}">${escapeHtml(r.name)}</a>
                  ${r.kana ? `<span class="kana"> ${escapeHtml(r.kana)}</span>` : ""}
                </td>
                <td>${escapeHtml(r.house)}</td>
                <td>${escapeHtml(r.kaiha)}</td>
                <td class="num">${formatNumber(r.n)}</td>
              </tr>`).join("")}
            </tbody>
          </table>
        </div>
        <p class="small muted">
          氏名・よみ・会派で照合しています。
          <strong>発言の絞り込み（会議名・期間）はこちらには効きません。</strong>
        </p>`;
    }

    // --- いつ議論されたか（月ごとの推移）-------------------------------------
    //
    // 件数はDBから引く（`monthlyHits()`）。**日付では GROUP BY せず rowid の
    // 範囲で割っている**ので、件数を数えるのと同じ手間で出る（`lib/query.ts`）。
    //
    // ★ 既定は**件数**。率（1,000発言あたり）に切り替えると、ページに埋め込んだ
    //   分母で割る。**同じデータでも結論が変わる**ので、どちらで見ているかは
    //   グラフの下に必ず書く（`monthlyChart` の figcaption）。

    const trendSection = el<HTMLElement>("trend");
    const trendChart = el<HTMLDivElement>("trend-chart");
    const trendNote = el<HTMLParagraphElement>("trend-note");

    /** 利用者が選んだ縦軸。**検索をやり直しても保つ**（毎回選び直させない） */
    let trendMode: MonthlyMode = "count";
    /** 直近の検索の月別件数。**切り替えだけならDBを引き直さない** */
    let trendPoints: MonthlyPoint[] | null = null;

    for (const input of document.querySelectorAll<HTMLInputElement>('input[name="trend-mode"]')) {
      input.addEventListener("change", () => {
        if (!input.checked) return;
        trendMode = input.value === "rate" ? "rate" : "count";
        drawTrend();
      });
    }

    function hideTrend() {
      trendPoints = null;
      trendSection.hidden = true;
      trendChart.innerHTML = "";
    }

    /** その検索の分母。会議名で絞っているならその会議のもの。
     *  **全体の分母で割ってはいけない**（分子だけ絞られて率が小さく出る）。 */
    function trendTotals(months: string[], meetingName: string | undefined): number[] {
      const source = meetingName ? trend.meetings[meetingName] : trend.totals;
      const at = new Map(trend.months.map((m, i) => [m, i]));
      return months.map((m) => source?.[at.get(m) ?? -1] ?? 0);
    }

    function drawTrend() {
      const st = state;
      if (!trendPoints?.length || !st) { trendSection.hidden = true; return; }

      // 横軸は**実際に引いた期間**に閉じる。引いてもいない期間まで並べると、
      // そこが「0件だった月」に見える。
      // ★ 年の選択（`from` / `until`）ではなく `opts.periods` から作ること。
      //   選択は逆順（2026年〜2021年）でも成立し、`periodsInYearRange()` が
      //   入れ替えて引いてくれる。年で判定すると、そのときだけ軸が空になって
      //   **グラフが黙って消える**
      const years = new Set((st.opts.periods ?? []).map((p) => p.slice(0, 4)));
      const inRange = (m: string) => !years.size || years.has(m.slice(0, 4));
      // 分母の側に無い月でも、当たっていれば軸に出す（配った分母より
      // 期間DBが新しいことがある。`toSeries` の keepHitsWithoutTotal と対）
      const months = [...new Set([...trend.months, ...trendPoints.map((p) => p.month)])]
        .filter(inRange).sort();

      const hits = new Map(trendPoints.map((p) => [p.month, p.n]));
      const totals = trendTotals(months, st.opts.meetingName);
      // 率に切り替えてよいのは、**当たった月すべてに分母があるとき**だけ。
      // 1か月でも欠けていると、その月だけ率0の棒になって「当たっていない」ように
      // 見える（配った分母より期間DBが新しいとき。月が変わった直後に、
      // 前日のHTMLを握ったままのブラウザで起きうる）
      const canRate = totals.some((t) => t > 0)
        && months.every((m, i) => totals[i] > 0 || !hits.get(m));
      const mode: MonthlyMode = trendMode === "rate" && canRate ? "rate" : "count";

      const points = toSeries(months, months.map((m) => hits.get(m) ?? 0), totals,
                              { keepHitsWithoutTotal: true });
      const what = mode === "count" ? "件数" : "1,000発言あたりの件数";
      trendChart.innerHTML = points.length
        ? monthlyChart(points, `${st.opts.query ?? ""} の月ごとの${what}`, mode)
        : "";

      const notes: string[] = [];
      if (st.opts.meetingName && mode === "rate") {
        notes.push(`分母は「${st.opts.meetingName}」の発言数です。`);
      }
      if (trendMode === "rate" && !canRate) {
        // 会議名の分母が無いときと、当たった月の分母が欠けているときの両方がここに来る
        notes.push("分母（その月の発言数）が揃わないため、件数で表示しています。");
      }
      trendNote.textContent = notes.join("");
      trendNote.hidden = !notes.length;
      trendSection.hidden = !points.length;
    }

    /** 争点語に一致するか。別表記（variants）も同じ争点として扱う。
     *  **大文字小文字を無視して突き合わせる。** 争点語は `ＬＧＢＴ` `生成ＡＩ` のように
     *  全角の大文字で書いてあるので、`lgbt` と打たれた分をここで拾えないと
     *  3.3倍遅い FTS に落ちる（`topic_hit` を使えず、別表記の合算も効かない）。
     *
     *  ★ **`indexed` が偽の語は拾わない。** 配信済みDBに `topic_hit` が無いので、
     *  引きに行くと**0件になる**（遅いのではなく間違う）。普通の検索経路に流せば
     *  同じ結果が出る（`scripts/build_db.py` の `stamp_indexed()`）。 */
    function matchTopic(query: string): TopicLite | null {
      const q = toFullWidth(query).trim().toUpperCase();
      return topics.find((t) => t.indexed
        && (t.term.toUpperCase() === q
            || (t.variants ?? []).some((v) => v.toUpperCase() === q))) ?? null;
    }

    /** 選ばれた年の範囲 → 引く期間ID。**配信DBは半期で割ってある**が、
     *  期間は年に閉じているので、この変換で日付の取りこぼしは出ない。 */
    function selectedPeriods(): string[] {
      return periodsInYearRange(periods, Number(fromSelect.value), Number(untilSelect.value));
    }

    /** 状態表示に出す「◯年分」。ファイル数ではなく年数で言う（利用者の単位）。 */
    function selectedYearCount(): number {
      return new Set(selectedPeriods().map((p) => p.slice(0, 4))).size;
    }

    /** まだ一覧に無い会議名を選べるようにする。
     *  **無い <option> の値を select.value に入れても選択されない**ので、
     *  URLで指定された会議名は一覧の到着を待たずにここで足しておく
     *  （待つと、共有されたURLの最初の検索が絞り込み無しで走ってしまう）。 */
    function ensureOption(value: string) {
      if (!value || [...meetingSelect.options].some((o) => o.value === value)) return;
      meetingSelect.insertAdjacentHTML("beforeend",
        `<option value="${escapeHtml(value)}">${escapeHtml(value)}</option>`);
    }

    /** このページのパス。**`#` を書き戻すときの基点**。
     *  本文パネルが開くと `location.pathname` は `/speech/<id>` に変わるので、
     *  そのとき相対の `#...` を積むと発言のURLに検索条件が付いてしまう。 */
    const SEARCH_PATH = location.pathname;

    /** 検索条件はURLに持たせる。結果をそのまま共有できるし、戻るボタンも効く。
     *
     *  ★ **クエリ文字列ではなくフラグメント（`#`）に持つ。** `?q=` は HTTPS でも
     *    配信事業者（Cloudflare）に届く。`#` より後ろはブラウザが要求に載せないので、
     *    「検索語は端末の外に出ない」と言える範囲がここで決まる
     *    （docs/DECISIONS.md「検索語はフラグメントに持つ」）。
     *
     *  ★ 古い `?q=` のURLも受ける。**受けたらその場で `#` の形に置き換える** ——
     *    最初の1回はもう届いているが、再読み込みと再共有では送られなくなる。
     *    JS 無効のときはトップの素の GET フォームがここへ `?q=` で飛んでくるので、
     *    **この経路は消えない**（プライバシーポリシーにそう書いてある）。 */
    function readUrl(): string {
      // ★ **解析する前に切る。** `maxlength` は JS からの代入を止めないので、
      //   細工した巨大なURLはここを素通りする。`canonicalQuery()` の上限は
      //   このあとの `run()` で掛かるが、**それでは URLSearchParams の解析と
      //   入力欄への代入が先に走ってしまう**（そこで固まる）。
      //   `MAX_URL_LENGTH` が `MAX_INPUT_LENGTH` よりずっと大きいのは、
      //   URL の中では日本語1文字が `%E5%AE%89` の9文字になるため。
      const legacy = new URLSearchParams(location.search.slice(0, MAX_URL_LENGTH));
      const p = legacy.has("q") ? legacy
        : new URLSearchParams(location.hash.slice(1, MAX_URL_LENGTH));
      queryInput.value = (p.get("q") ?? "").slice(0, MAX_INPUT_LENGTH);
      // 戻るボタンで絞り込み無しのURLへ戻ったら、選択も外す。
      // **会議名も切る** — <option> のラベルとしてそのまま入る
      const meeting = (p.get("meeting") ?? "").slice(0, MAX_MEETING_LENGTH);
      ensureOption(meeting);
      meetingSelect.value = meeting;
      if (p.get("from")) fromSelect.value = p.get("from")!;
      if (p.get("until")) untilSelect.value = p.get("until")!;
      // 切ったあとの値でURLを書き戻す（`run()` も `replaceState` で正規形に直す）
      if (legacy.has("q")) history.replaceState(null, "", `${SEARCH_PATH}#${p}`);
      return queryInput.value;
    }

    let state: { opts: SearchOptions; terms: string[]; topic: TopicLite | null;
                 plan: QueryPlan | null; before: Record<string, number> } | null = null;
    /** 検索の世代。**古い検索が後から返ってきても捨てる**ための番号。
     *  重い検索の裏で条件を変えると、前の結果が新しい画面に混ざる。 */
    let generation = 0;
    /** 半角で打たれた語を全角に寄せたときの但し書き。**黙って書き換えない。** */
    let convertedNote = "";

    /** どの索引を使ったか。snippet() のマーカーが付くのは FTS のときだけなので、
     *  それ以外では語を渡して強調する。 */
    function renderOpts() {
      const marked = !state?.topic && state?.plan?.mode === "fts";
      return { terms: marked ? [] : state?.terms ?? [], groupByYear: true };
    }

    async function run(pushUrl = true) {
      // 会議録の英数字は全部全角。半角で打たれた語は寄せてから引く（`docs/DECISIONS.md`）。
      // 2文字以下の語は語彙が大文字なのでそこまで寄せる。
      // **入力欄とURLも書き換える。** 実際に引いた語を見せたいのと、
      // 共有されたURLが1つに定まるため（`AI` `ＡＩ` `ａｉ` で別のURLにしない）
      const raw = queryInput.value.trim();
      const query = canonicalQuery(raw);
      queryInput.value = query;
      convertedNote = query === raw ? "" : `・「${query}」として検索しました`;
      if (!query) { statusEl.textContent = "キーワードを入れて検索してください。"; return; }

      const gen = ++generation;
      const topic = matchTopic(query);
      const chosen = selectedPeriods();

      // 議員はDBを引かないので、発言の結果を待たずにここで確定する
      userPickedTab = false;
      showPeople(query);

      // **仕様上0件になる語は、DBを引く前に説明する。**
      // 争点語に一致していれば topic_hit を引けるので、そちらが優先（`ＡＩ` など）
      const cannot = topic ? [] : unsearchableTerms(splitTerms(query));

      // ★ **URLは常に、実際に引いた語に書き戻す。** `pushUrl` が偽でも `replaceState`
      //   で直す（履歴は増やさない）。ここを飛ばすと、上限で切った検索や全角に
      //   寄せた検索で、**URLに残る語と画面・結果の語が食い違う**
      //   （細工したURLで17語目を足すと、画面16語・URL17語になっていた）。
      {
        const p = new URLSearchParams({ q: query, from: fromSelect.value, until: untilSelect.value });
        if (meetingSelect.value) p.set("meeting", meetingSelect.value);
        // ★ `?` ではなく `#`。理由は readUrl() の上
        const url = `${SEARCH_PATH}#${p}`;
        if (pushUrl) history.pushState(null, "", url);
        else if (location.pathname + location.hash !== url) history.replaceState(null, "", url);
      }

      results.innerHTML = "";
      moreWrap.hidden = true;
      hideTrend();
      statusEl.textContent = "検索中…";
      const started = performance.now();

      if (cannot.length) { showUnsearchable(cannot); return; }

      try {
        // 争点語なら topic_hit（別表記も合算される）。それ以外は語の長さで引き先が決まる。
        // 解くのは1回だけで、ページ送りでは使い回す
        const plan = topic ? null : await resolveQuery(query, chosen);
        if (gen !== generation) return;   // その間に次の検索が始まっていたら捨てる
        const opts: SearchOptions = {
          query, topicId: topic?.id, plan: plan ?? undefined, periods: chosen,
          meetingName: meetingSelect.value || undefined, limit: 20,
        };
        state = { opts, terms: splitTerms(query), topic, plan, before: {} };

        const page = await search(opts);
        if (gen !== generation) return;
        state.before = page.before;
        show(page, started, gen);
      } catch (err) {
        if (gen !== generation) return;
        statusEl.innerHTML = `<span class="error">検索に失敗しました: ${escapeHtml(describeError(err))}</span>`;
        console.error(err);
      }
    }

    /** **仕様上引けない語**を打たれたとき。DBは引かずにここで止める。
     *
     *  「索引に無い」ではなく「索引に入りようがない」ものだけがここに来る
     *  （`unsearchableTerms()`）。**黙って0件にしない**のは、利用者からは
     *  「その語が国会で使われていない」と区別が付かないため。
     *  1文字足せば FTS が引けるので、そこまで書く。 */
    function showUnsearchable(cannot: string[]) {
      el("count-speeches").textContent = " 0";
      autoSelectTab(0);
      statusEl.textContent = "検索できない語です";
      const words = cannot.map((w) => `「${escapeHtml(w)}」`).join("");
      results.innerHTML = `
        <div class="notfound">
          <p>${words}はこの検索では引けません。</p>
          <p class="small muted">
            2文字以下の語は全文検索の索引（3文字未満を作れない）とは別の索引で引いていて、
            そこに入るのは<strong>漢字だけ・カタカナだけ・英数字だけ</strong>の2文字です。
            ひらがなだけの2文字（「ため」）、文字種をまたぐ2文字（「お金」「踏ま」）、
            1文字だけの語は入っていません。
            <strong>1文字足すと引けます</strong>（例:「踏まえ」）。
            <a href="/about">このサイトについて</a>
          </p>
          ${relatedTopicChips(cannot)}
        </div>`;
    }

    /** 0件のときに出す、その語を含む争点語。**行き止まりにしないための導線。**
     *
     *  以前は「2文字語が語彙に無い」ときの案内としてこれを出していた。索引が
     *  本文の2文字窓を全部持つようになって「引けない語」が無くなったので、
     *  **条件を「本当に0件だったとき」に付け替えてある**。
     *
     *  0件は議員名を打たれたときにも起きる（姓は発言本文にあまり出ない）。
     *  そのときは議員のタブに当たりがあるので、`autoSelectTab` がそちらへ寄せる。 */
    function relatedTopicChips(terms: string[]): string {
      // **大文字小文字は無視する**（matchTopic と同じ理由。`ai` で `生成ＡＩ` を出す）
      const related = topics
        .filter((t) => terms.some((w) => t.term.toUpperCase().includes(w.toUpperCase())))
        .slice(0, 12);
      // ★合う争点語が1つも無いときも**行き止まりにしない**。
      //   「0件でした」だけを出して終わると、次に何を試せばいいのか分からない
      if (!related.length) {
        return `<p class="small">ほかの入口から探せます:</p>
          <ul class="chips">
            <li><a class="chip" href="/topics">争点語の一覧</a></li>
            <li><a class="chip" href="/frequent">頻出語の一覧</a></li>
            <li><a class="chip" href="/politicians">議員の一覧</a></li>
          </ul>`;
      }
      return `<p class="small">この語を含む争点語なら、まとまった集計があります:</p>
        <ul class="chips">${related.map((t) =>
          `<li><a class="chip" href="/topic/${t.id}">${escapeHtml(t.term)}</a></li>`).join("")}</ul>`;
    }

    function show(page: SearchPage, started: number, gen: number) {
      const elapsed = Math.round(performance.now() - started);
      moreWrap.hidden = page.done;

      if (!page.rows.length) {
        el("count-speeches").textContent = " 0";
        autoSelectTab(0);
        results.innerHTML = `<div class="notfound">
          <p>一致する発言はありませんでした。</p>
          ${relatedTopicChips(state?.terms ?? [])}
        </div>`;
        statusEl.textContent = `0件・${elapsed}ms${convertedNote}`;
        return;
      }

      autoSelectTab(page.rows.length);
      results.insertAdjacentHTML("beforeend", renderSpeeches(page.rows, renderOpts()));
      statusEl.textContent =
        `${selectedYearCount()}年分を並列に検索・${elapsed}ms${convertedNote}`;

      // 月ごとの件数。**件数（下）とは別に引く。** 絞り込みが無ければ件数は索引の
      // 1行で出るので（`countQuery` の近道）、そちらを月別で置き換えると
      // 速い場合まで遅くなる。同じ索引を2度読むが、2度目はワーカのキャッシュに乗る
      monthlyHits(state!.opts).then((points) => {
        if (gen !== generation || !state) return;
        trendPoints = points;
        drawTrend();
      }).catch((e) => console.warn("月別の件数を引けなかった", e));

      // 総件数は別に数える。FTS の COUNT は結果取得と同じくらい重いので待たせない
      const opts = state!.opts;
      countHits(opts).then((n) => {
        if (gen !== generation || !state) return;   // その間に次の検索が始まっていたら捨てる
        el("count-speeches").textContent = ` ${formatNumber(n)}`;
        const how = state.topic ? "（争点語の集計から）"
          : state.plan?.mode === "word" ? "（2文字語の索引から）" : "";
        statusEl.textContent =
          `${formatNumber(n)}件${how}・${selectedYearCount()}年分を並列に検索`
          + `・${elapsed}ms${convertedNote}`;
      }).catch((e) => console.warn("件数を数えられなかった", e));
    }

    moreBtn.addEventListener("click", async () => {
      if (!state) return;
      const gen = generation;
      moreBtn.disabled = true;
      moreBtn.textContent = "読み込み中…";
      try {
        const page = await search({ ...state.opts, before: state.before });
        if (gen !== generation) return;   // その間に条件が変わっていたら捨てる
        state.before = page.before;
        results.insertAdjacentHTML("beforeend", renderSpeeches(page.rows, renderOpts()));
        moreWrap.hidden = page.done;
      } catch (err) {
        console.error(err);
      } finally {
        moreBtn.disabled = false;
        moreBtn.textContent = "さらに読み込む";
      }
    });

    form.addEventListener("submit", (e) => { e.preventDefault(); run(); });
    window.addEventListener("popstate", () => { if (readUrl()) run(false); });

    // 会議名は meeting テーブル（1年で約1,100行）から拾う。
    // **選んでいる期間の全年から拾う。** 直近年だけだと、過去年にしか無い会議
    //（「予算委員会第一分科会」など）をUIから選べない。年ごとにキャッシュされる
    let meetingGen = 0;
    async function loadMeetingNames() {
      const gen = ++meetingGen;
      const keep = meetingSelect.value;   // 選択中の会議は期間外でも外さない
      try {
        const names = await meetingNames(selectedPeriods());
        if (gen !== meetingGen) return;
        meetingSelect.innerHTML = `<option value="">すべて</option>`;
        meetingSelect.insertAdjacentHTML("beforeend",
          names.map((n) => `<option value="${escapeHtml(n)}">${escapeHtml(n)}</option>`).join(""));
        ensureOption(keep);
        meetingSelect.value = keep;
      } catch (e) {
        console.warn("会議名を取れなかった", e);
      }
    }
    for (const sel of [fromSelect, untilSelect]) {
      sel.addEventListener("change", () => { loadMeetingNames(); });
    }

    // 一覧の到着は待たない。URL指定の会議名は readUrl() が <option> ごと作る
    if (readUrl()) run(false);
    else queryInput.focus();
    loadMeetingNames();
  </script>

  <style>
    /* `.kana` と `.notfound` は Base.astro の共通定義。
       ★どちらも `innerHTML` で差し込む側にも出るので、scoped に戻すと
       そちらだけ素の見た目になる（実際にそうなっていた） */
    .tabs {
      display: flex; gap: 0.25rem; margin: 1.25rem 0 0;
      border-bottom: 1px solid var(--line);
    }
    .tabs [role="tab"] {
      background: none; border: 1px solid transparent; border-bottom: none;
      border-radius: var(--radius-sm) var(--radius-sm) 0 0; padding: 0.5rem 1.1rem;
      color: var(--muted); font-size: 0.95rem; cursor: pointer;
      margin-bottom: -1px;
    }
    .tabs [role="tab"]:hover { color: var(--fg); background: var(--tint); }
    /* 選択中は**色だけで示さない**（枠・地・太さの3つで出す） */
    .tabs [role="tab"][aria-selected="true"] {
      color: var(--fg); font-weight: 700;
      border-color: var(--line-strong); background: var(--bg);
    }
    .tab-count { font-variant-numeric: tabular-nums; font-weight: 400; color: var(--muted); }
    [role="tabpanel"] { padding-top: 0.5rem; }

    /* 縦軸の切り替え。fieldset の既定の枠は消す（見出しの下に並ぶだけのもの） */
    .trend-mode { border: 0; padding: 0; margin: 0.25rem 0 0; display: flex; gap: 1rem; }
    .trend-mode label {
      display: inline-flex; align-items: center; gap: 0.3rem;
      font-size: 0.9rem; color: var(--muted); cursor: pointer;
    }
    #trend h2 { margin-bottom: 0; }
    #trend { margin-bottom: 1.25rem; }

    .search-form { margin: 1rem 0 0.5rem; }
    .row { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: flex-end; }
    .grow { flex: 1 1 20rem; }
    label { display: block; }
    .label { display: block; font-size: 0.8rem; color: var(--muted); margin-bottom: 0.15rem; }
    #q { width: 100%; }
    .filters { margin-top: 0.75rem; font-size: 0.95rem; }
    .filters summary { cursor: pointer; color: var(--muted); font-size: 0.9rem; }
    .filters .row { margin-top: 0.6rem; }
    .range { display: inline-flex; align-items: center; gap: 0.4rem; }
  </style>
</Base>
