---
/**
 * 争点語のページ。頻度推移 + 会派ごとの使われ方 + 発言一覧。
 *
 * グラフは `data/dist/topics.json`（258KB）だけで描けるので**ビルド時に SVG にする**。
 * DBを一切引かないので即座に出るし、検索エンジンにも中身が渡る。
 * 発言一覧だけがブラウザからの `topic_hit` 引き（0.7秒）。
 */
import Base from "../../layouts/Base.astro";
import { topicSeries, manifest } from "../../lib/site-data";
import { toSeries, monthlyChart, kaihaRates } from "../../lib/chart";
import { formatNumber } from "../../lib/format";

export function getStaticPaths() {
  const data = topicSeries();
  return data.topics.map((topic) => ({ params: { id: String(topic.id) }, props: { topic } }));
}

const { topic } = Astro.props;
const data = topicSeries();
const periods = manifest().periods;

const series = data.series[String(topic.id)] ?? {};
const overall = toSeries(data.months, series["*"] ?? [], data.speech_totals["*"] ?? []);
const chart = monthlyChart(overall, `${topic.term} の月ごとの出現率`);
const byKaiha = kaihaRates(data.kaiha, series, data.speech_totals);

// ピークの月。「いつ議論されたか」が争点語ページで一番知りたいこと
const peak = [...overall].sort((a, b) => b.rate - a.rate)[0];

const description =
  `国会で「${topic.term}」がいつ、どの会派から発言されたか。` +
  `${formatNumber(topic.n_speeches)}件の発言を月ごとの出現率で見られます。`;
---

<Base title={`${topic.term} の頻度推移`} description={description}>
  <p class="small"><a href="/topics">← 争点語の一覧</a></p>

  <h1>{topic.term}</h1>
  <p class="small muted">
    {topic.category && <>分類: {topic.category}・</>}
    {formatNumber(topic.n_speeches)}件の発言に{formatNumber(topic.n_occurrences)}回
    {topic.variants.length > 0 && <>・別表記として {topic.variants.join("、")} も同じ語として数えています</>}
  </p>

  <section>
    <h2>いつ議論されたか</h2>
    <Fragment set:html={chart} />
    {peak && (
      <p class="small muted">
        最も多かったのは {peak.month.slice(0, 4)}年{Number(peak.month.slice(5, 7))}月
        （{peak.hits}件 / {formatNumber(peak.total)}発言 ＝ 1,000発言あたり {peak.rate.toFixed(1)}件）。
      </p>
    )}
  </section>

  <section>
    <h2>会派ごとの使われ方</h2>
    <p class="small muted">
      その会派の全発言に占める割合です。<strong>発言数の多い会派ほど件数は増える</strong>ので、
      件数のままでは比べられません。合計2,000発言に満たない会派は率が振れるため外してあります。
      政党ではなく<strong>会派</strong>で出しているのは、政党を特定できない発言が3.6%あるためです。
    </p>
    <div class="scroll-x">
      <table>
        <thead>
          <tr>
            <th>会派</th><th class="num">発言</th><th class="num">全発言</th>
            <th class="num">1,000発言あたり</th><th></th>
          </tr>
        </thead>
        <tbody>
          {byKaiha.map((r) => (
            <tr>
              <td>{r.kaiha}</td>
              <td class="num">{formatNumber(r.hits)}</td>
              <td class="num muted">{formatNumber(r.total)}</td>
              <td class="num">{r.rate.toFixed(1)}</td>
              {/* ★ 幅は **SVG の width 属性**で出す。`style="width:…%"` は
                  CSP（`style-src 'self'`）に黙って無視され、**全部同じ長さになる**。
                  実際に公開時からそうなっていた（site/public/_headers）。
                  viewBox を 0 0 100 6 にしてあるので width がそのまま％になる */}
              <td class="barcell">
                <svg class="minibar" viewBox="0 0 100 6" preserveAspectRatio="none"
                     role="img" aria-label={`${r.rate.toFixed(1)}（1,000発言あたり）`}>
                  <rect height="6" rx="2"
                        width={byKaiha[0].rate ? (100 * r.rate / byKaiha[0].rate).toFixed(1) : 0} />
                </svg>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="small muted">
      よく使う会派が「賛成」「反対」のどちらかは、この数字からは分かりません。
      発言そのものを読んで判断してください。
    </p>
  </section>

  <section>
    <h2>この語を含む発言</h2>
    <p id="status" class="status" role="status" aria-live="polite">読み込み中…</p>
    <div id="results"></div>
    <p id="more-wrap" hidden><button id="more">さらに読み込む</button></p>
  </section>

  <script
    is:inline
    type="application/json"
    id="site-data"
    set:html={JSON.stringify({ topicId: topic.id, term: topic.term, periods })}
  />

  <script>
    import { search } from "../../lib/db";
    import { renderSpeeches } from "../../lib/render";
    // 抜粋のクリックを横取りして本文パネルを出す（広い画面だけ）。
    // 狭い画面・JS無効では /speech/<id> へそのまま遷移する
    import { initSpeechPanel } from "../../lib/speech-panel";
    import { describeError, escapeHtml } from "../../lib/format";

    initSpeechPanel();

    const { topicId, term, periods } = JSON.parse(
      document.getElementById("site-data")!.textContent!,
    ) as { topicId: number; term: string; periods: string[] };

    const statusEl = document.getElementById("status")!;
    const results = document.getElementById("results")!;
    const moreWrap = document.getElementById("more-wrap") as HTMLParagraphElement;
    const moreBtn = document.getElementById("more") as HTMLButtonElement;

    let cursor: Record<string, number> | undefined;

    async function run(append: boolean) {
      const started = performance.now();
      try {
        // 争点語は FTS を通さず topic_hit を引く。3.3倍速く、2文字語もここでだけ引ける
        const page = await search({ topicId, periods, limit: 20,
                                    before: append ? cursor : undefined });
        cursor = page.before;
        results.insertAdjacentHTML("beforeend",
          renderSpeeches(page.rows, { terms: [term], groupByYear: true }));
        moreWrap.hidden = page.done;
        statusEl.textContent = `新しい順・${Math.round(performance.now() - started)}ms`;
      } catch (err) {
        statusEl.innerHTML = `<span class="error">読み込みに失敗しました: ${escapeHtml(describeError(err))}</span>`;
        console.error(err);
      }
    }

    moreBtn.addEventListener("click", async () => {
      moreBtn.disabled = true;
      await run(true);
      moreBtn.disabled = false;
    });

    run(false);
  </script>

  <style>
    /* `.chart …` 一式と `.note` は Base.astro の共通定義。
       `.chart` は `is:global` でないと当たらない（`set:html` で入るのでスコープ
       属性が付かない）。**ここへ戻さないこと** — `/word/<語>` と
       `/politician/<id>` にも同じものが要る。 */
    .barcell { width: 30%; }
    .minibar { display: block; width: 100%; height: 0.6rem; }
    .minibar rect { fill: var(--accent); opacity: 0.7; }
  </style>
</Base>
