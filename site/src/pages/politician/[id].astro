---
/**
 * 議員ページ。1,111人ぶんを事前生成する。
 *
 * 静的に出すのは**氏名・よみ・院・所属会派の時系列・発言数**まで。
 * 発言そのものはブラウザが年DBから引く（全部で650,785件あり事前生成できない）。
 * それでも氏名で検索されたときに中身のあるページが返るのが事前生成の目的。
 *
 * ★タイムラインの SQL は `speech(politician_id)` の索引だけで
 *   `ORDER BY rowid DESC` を降順スキャンさせる。索引に date を足すと
 *   27リクエスト → 509リクエストになる（`docs/DECISIONS.md`）。
 */
import Base from "../../layouts/Base.astro";
import { politicians, manifest, latestAffiliation, activity, densify } from "../../lib/site-data";
import { periodOf } from "../../lib/query";
import { stackedMonthlyChart, type StackedSeries } from "../../lib/chart";
import { formatNumber } from "../../lib/format";

/** 委員会に振る色。**並び順が意味を持つ**（Base.astro の注記）。
 *  「その他」は identity ではないので色相を与えない。 */
const CAT = ["var(--cat-1)", "var(--cat-2)", "var(--cat-3)", "var(--cat-4)",
             "var(--cat-5)", "var(--cat-6)", "var(--cat-7)"];
const catColor = (label: string, i: number) =>
  label === "その他" ? "var(--cat-other)" : CAT[i % CAT.length];

export function getStaticPaths() {
  return politicians().map((p) => ({ params: { id: String(p.id) }, props: { person: p } }));
}

const { person } = Astro.props;
const current = latestAffiliation(person);

// 発言があった期間だけ問い合わせる。無関係な期間のワーカを立てない。
// **期間IDは辞書順が時系列順**なので、日付から作った期間IDと文字列比較で絞れる
const activePeriods = manifest().periods.filter((p) => {
  const from = person.first_date ? periodOf(person.first_date, manifest().period) : "";
  const to = person.last_date ? periodOf(person.last_date, manifest().period) : "9999";
  return p >= from && p <= to;
});

const affiliations = [...person.affiliations].sort((a, b) => b.start_date.localeCompare(a.start_date));

// 発言数の推移。**横軸はサイトの全期間**（この議員の発言がある月に詰めない）。
// いつ始まり、いつ止まったかが見えるのはそのため（build_activity.py の注記）
const act = activity();
const mine = act.politicians[String(person.id)];
const series: StackedSeries[] = (mine?.committees ?? []).map((label, i) => ({
  label,
  values: densify(mine!.series[i] ?? [], act.months.length),
  color: catColor(label, i),
}));
const chart = stackedMonthlyChart(act.months, series, `${person.name} の月ごとの発言数（委員会別）`);
// 年の選択肢。**在籍年ではなくサイトの全期間**から作る
const allYears = [...new Set(act.months.map((m) => m.slice(0, 4)))];

const description =
  `${person.name}（${current?.kaiha ?? "会派不明"}）の国会での発言 ${formatNumber(person.n_speeches)}件を` +
  `時系列で見られます。${person.first_date ?? ""}〜${person.last_date ?? ""}。`;
---

<Base title={person.name} description={description}>
  <article>
    <header class="person">
      <h1>
        {person.name}
        {person.name_kana && <span class="kana">{person.name_kana}</span>}
      </h1>
      <dl class="facts">
        <div><dt>院</dt><dd>{person.house ?? "—"}</dd></div>
        <div><dt>会派</dt><dd>{current?.kaiha ?? "—"}</dd></div>
        <div><dt>発言数</dt><dd>{formatNumber(person.n_speeches)}</dd></div>
        <div><dt>期間</dt><dd class="small">{person.first_date} 〜 {person.last_date}</dd></div>
      </dl>
      <p class="small muted links">
        {person.official_url && (<a href={person.official_url} rel="noopener nofollow">公式サイト</a>)}
        {person.wikidata_id && (
          <a href={`https://www.wikidata.org/wiki/${person.wikidata_id}`} rel="noopener">Wikidata</a>
        )}
      </p>
    </header>

    <section>
      <h2>所属会派</h2>
      <div class="scroll-x">
        <table>
          <thead>
            <tr><th>会派</th><th>政党</th><th>期間</th><th class="num">発言数</th></tr>
          </thead>
          <tbody>
            {affiliations.map((a) => (
              <tr>
                <td>{a.kaiha ?? "—"}</td>
                {/* party が NULL なのは「特定できていない」であって「無所属」ではない */}
                <td>{a.party ?? <span class="muted">特定できず</span>}</td>
                <td class="small">{a.start_date} 〜 {a.end_date}</td>
                <td class="num">{formatNumber(a.n_speeches)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small muted">
        期間は「その会派で発言した最初と最後の日」で、在籍期間そのものではありません。
      </p>
    </section>

    {series.length > 0 && (
      <section id="activity">
        <h2>発言数の推移</h2>
        <p class="small muted">
          <strong>発言の中身には触れていません。数だけです。</strong>
          発言数は<strong>委員会の所属と役職で決まる</strong>もので、
          活動量や熱心さの指標ではありません。
          大臣や委員長になると答弁・議事整理で数が動きますし、
          所属していない委員会の発言は当然ゼロになります。
          <strong>ほかの議員と比べるためのものではありません。</strong>
        </p>

        <p class="period-row">
          <label class="sr-only" for="from-year">開始年</label>
          <select id="from-year">
            {allYears.map((y) => <option value={y}>{y}年</option>)}
          </select>
          〜
          <label class="sr-only" for="until-year">終了年</label>
          <select id="until-year">
            {allYears.map((y) => <option value={y} selected={y === allYears.at(-1)}>{y}年</option>)}
          </select>
          <span id="period-total" class="small muted"></span>
        </p>

        <div id="chart"><Fragment set:html={chart} /></div>

        {/* ★表は必須。light では一部の色が面とのコントラスト3:1未満で、
            「色だけに頼らせない」ことを条件に配色が通っている（Base.astro） */}
        <div class="scroll-x">
          <table id="activity-table">
            <thead>
              <tr><th>委員会</th><th class="num">発言数</th></tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </section>
    )}

    <section>
      <h2>発言</h2>
      <p class="filter-row">
        <label class="sr-only" for="within">この議員の発言を絞り込む</label>
        <input type="search" id="within" placeholder="この議員の発言をキーワードで絞り込む"
               autocomplete="off" enterkeyhint="search" />
        <button id="within-go">絞り込む</button>
        <button id="within-clear" hidden>解除</button>
      </p>
      <p id="status" class="status" role="status" aria-live="polite">読み込み中…</p>
      <div id="results"></div>
      <p id="more-wrap" hidden><button id="more">さらに読み込む</button></p>
    </section>
  </article>

  <script
    is:inline
    type="application/json"
    id="site-data"
    set:html={JSON.stringify({ id: person.id, periods: activePeriods })}
  />

  {/* 発言数の推移。この議員のぶんだけ（全期間64月 × 最大8系列で数KB）。
      DBは引かない */}
  {series.length > 0 && (
    <script
      is:inline
      type="application/json"
      id="activity-data"
      set:html={JSON.stringify({
        months: act.months,
        series: series.map((s) => ({ label: s.label, values: s.values, color: s.color })),
        name: person.name,
      })}
    />
  )}

  <script>
    // 期間の絞り込み。**ビルド時と同じ関数で描き直す**（2つ書くとずれる）
    import { stackedMonthlyChart, type StackedSeries } from "../../lib/chart";
    import { escapeHtml, formatNumber } from "../../lib/format";

    const raw = document.getElementById("activity-data");
    if (raw) {
      const { months, series, name } = JSON.parse(raw.textContent!) as {
        months: string[]; series: StackedSeries[]; name: string;
      };
      const fromSel = document.getElementById("from-year") as HTMLSelectElement;
      const untilSel = document.getElementById("until-year") as HTMLSelectElement;
      const chartEl = document.getElementById("chart")!;
      const tbody = document.querySelector("#activity-table tbody")!;
      const totalEl = document.getElementById("period-total")!;

      function apply() {
        // 開始が終了を追い越したら、押されたほうに合わせる
        if (fromSel.value > untilSel.value) untilSel.value = fromSel.value;
        const keep = months
          .map((m, i) => ({ m, i }))
          .filter(({ m }) => m.slice(0, 4) >= fromSel.value && m.slice(0, 4) <= untilSel.value);

        const shown = keep.map((k) => k.m);
        // ★ 色は系列に付いたまま持ち回る。件数0で落ちた委員会があっても
        //   生き残りの色は変わらない（chart.ts の注記）
        const sliced = series
          .map((s) => ({ ...s, values: keep.map(({ i }) => s.values[i] ?? 0) }))
          .filter((s) => s.values.some((v) => v > 0));

        chartEl.innerHTML = shown.length && sliced.length
          ? stackedMonthlyChart(shown, sliced, `${name} の月ごとの発言数（委員会別）`)
          : `<p class="status">この期間の発言はありません。</p>`;

        const rows = sliced
          .map((s) => ({ label: s.label, n: s.values.reduce((a, b) => a + b, 0) }))
          .sort((a, b) => b.n - a.n);
        const total = rows.reduce((sum, r) => sum + r.n, 0);
        tbody.innerHTML = rows.map((r) => `
          <tr><td>${escapeHtml(r.label)}</td><td class="num">${formatNumber(r.n)}</td></tr>`).join("")
          + (rows.length > 1
            ? `<tr><td><strong>合計</strong></td><td class="num"><strong>${formatNumber(total)}</strong></td></tr>`
            : "");
        totalEl.textContent = `${formatNumber(total)}件`;
      }

      fromSel.addEventListener("change", apply);
      untilSel.addEventListener("change", apply);
      apply();
    }
  </script>

  <script>
    import { politicianSpeeches, search, resolveQuery, splitTerms, canonicalQuery,
             unsearchableTerms, type SearchPage, type QueryPlan } from "../../lib/db";
    import { renderSpeeches } from "../../lib/render";
    // 抜粋のクリックを横取りして本文パネルを出す（広い画面だけ）。
    // 狭い画面・JS無効では /speech/<id> へそのまま遷移する
    import { initSpeechPanel } from "../../lib/speech-panel";
    import { escapeHtml } from "../../lib/format";

    initSpeechPanel();

    const { id, periods } = JSON.parse(
      document.getElementById("site-data")!.textContent!,
    ) as { id: number; periods: string[] };

    const el = <T extends HTMLElement>(x: string) => document.getElementById(x) as T;
    const statusEl = el("status"), results = el("results");
    const moreWrap = el<HTMLParagraphElement>("more-wrap"), moreBtn = el<HTMLButtonElement>("more");
    const within = el<HTMLInputElement>("within");
    const clearBtn = el<HTMLButtonElement>("within-clear");

    let cursor: Record<string, number> = {};
    let term = "";
    // 絞り込みの語をどの索引で引くかは1回だけ解く（2文字語は word_hit を引く）
    let plan: QueryPlan | null = null;
    /** 読み込みの世代。絞り込みを素早く切り替えると、前の重い検索が後から
     *  返ってきて新しい画面に混ざる。**古い世代の結果は捨てる。** */
    let generation = 0;

    const load = (before?: Record<string, number>): Promise<SearchPage> =>
      term
        // 議員 × キーワード。索引の結果を politician_id で絞る
        ? search({ query: term, plan: plan ?? undefined, politicianId: id,
                   periods, limit: 20, before })
        : politicianSpeeches(id, periods, 20, before ?? {});

    async function run(append: boolean) {
      const gen = ++generation;
      if (!append) results.innerHTML = "";
      statusEl.textContent = "読み込み中…";
      moreWrap.hidden = true;
      const started = performance.now();

      // **仕様上0件になる語は引かずに説明する**（検索ページと同じ判定）。
      // 「その議員が言っていない」と区別が付かないまま0件を出さない
      const cannot = unsearchableTerms(splitTerms(term));
      if (cannot.length) {
        results.innerHTML = "";
        moreWrap.hidden = true;
        statusEl.innerHTML =
          `「${escapeHtml(cannot.join("・"))}」はこの検索では引けません`
          + `<span class="small muted">（2文字以下は漢字・カタカナ・英数字だけの2文字に限られます。`
          + `1文字足すと引けます）</span>`;
        return;
      }

      try {
        if (term && !append) {
          const resolved = await resolveQuery(term, periods);
          if (gen !== generation) return;
          plan = resolved;
        }
        const page = await load(append ? cursor : undefined);
        if (gen !== generation) return;
        cursor = page.before;
        results.insertAdjacentHTML("beforeend",
          renderSpeeches(page.rows, { terms: splitTerms(term), groupByYear: true, showSpeaker: false }));
        moreWrap.hidden = page.done;
        const elapsed = Math.round(performance.now() - started);
        statusEl.textContent = page.rows.length || append
          ? `新しい順・${elapsed}ms`
          : term ? `「${term}」を含む発言はありませんでした。` : "発言が見つかりません。";
      } catch (err) {
        if (gen !== generation) return;
        statusEl.innerHTML = `<span class="error">読み込みに失敗しました: ${escapeHtml(String(err))}</span>`;
        console.error(err);
      }
    }

    moreBtn.addEventListener("click", async () => {
      moreBtn.disabled = true;
      await run(true);
      moreBtn.disabled = false;
    });

    function applyFilter() {
      // 会議録の英数字は全部全角なので、半角で打たれた語を寄せてから引く。
      // 入力欄も書き換えて、実際に引いた語を見せる（`docs/DECISIONS.md`）
      term = canonicalQuery(within.value).trim();
      within.value = term;
      clearBtn.hidden = !term;
      cursor = {};
      run(false);
    }

    el("within-go").addEventListener("click", applyFilter);
    within.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Enter") { e.preventDefault(); applyFilter(); }
    });
    clearBtn.addEventListener("click", () => { within.value = ""; applyFilter(); });

    run(false);
  </script>

  <style>
    .person h1 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.6rem; }
    .person .kana { font-size: 0.9rem; font-weight: 400; color: var(--muted); }

    .facts { display: flex; flex-wrap: wrap; gap: 0.75rem 2.5rem; margin: 0.5rem 0 0.75rem; }
    .facts dt { font-size: 0.75rem; color: var(--muted); }
    .facts dd { margin: 0; font-size: 1.05rem; font-variant-numeric: tabular-nums; }

    .links a + a { margin-left: 1rem; }

    .filter-row { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
    #within { flex: 1 1 18rem; }

    .period-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin: 1rem 0; }
    #activity-table { max-width: 32rem; }

    .sr-only {
      position: absolute; width: 1px; height: 1px; overflow: hidden;
      clip: rect(0 0 0 0); white-space: nowrap;
    }
  </style>
</Base>
