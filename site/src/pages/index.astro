---
/**
 * トップ。**語から入るページ**（site/README.md「トップの順序は仕様」）。
 *
 * 順序がそのまま「何を主機能とみなしているか」の表明になる:
 *
 *   1. いま議論されていること（急増語）  ← 唯一「今」を示す
 *   2. 争点語（運営が選んだ82語）
 *   3. 頻出語（機械抽出の500語）
 *   4. 検索                              ← 入口の1つに降ろした。**消してはいない**
 *   5. 議員
 *
 * ★ **議員を「発言数の多い順」で並べない。** 発言数は委員会の所属と役職で決まるので、
 *   トップに並べると事実上の議員評価になる（docs/SCOPE.md）。件数と一覧への導線だけ出す。
 *
 * ★ 急増語の中身は主に**審議中の法案の専門用語**であって「今週の争点」ではない。
 *   表示の言葉を誇張しないこと（docs/ARCHITECTURE.md）。
 */
import Base from "../layouts/Base.astro";
import { trending, topicSeries, politicians, frequent } from "../lib/site-data";
import { formatDate, formatNumber } from "../lib/format";

const t = trending();
// windows は新しい順に並んでいる（build_topics.py の出力）
const latest = t.windows[0];
const terms = latest.terms.slice(0, 14);

// 争点語は発言数の多い順に。ここが2文字語（憲法・年金）への唯一の入口でもある
const allTopics = topicSeries().topics;
const topicCount = allTopics.length;
const topics = [...allTopics].sort((a, b) => b.n_speeches - a.n_speeches).slice(0, 12);

// 頻出語（機械抽出）。**争点語とは別の層**なので節を分けて出す（CLAUDE.md）
const freq = frequent();
// 山が今年に立った語を、跳ね幅の大きい順に。トップに置く意味があるのは
// 「いま議論されている語」なので、ピーク月の新しい順ではなく**その年のうち跳ねた順**
const thisYear = freq.months.at(-1)!.slice(0, 4);
const recent = freq.words
  .filter((w) => w.peak.startsWith(thisYear))
  .sort((a, b) => b.burst - a.burst)
  .slice(0, 12);
// 急上昇語のうち、推移ページを持っている語はそちらへ送る（検索より情報が多い）
const wordPages = new Map(freq.words.filter((w) => w.topic_id == null).map((w) => [w.term, w]));

function termHref(term: string, topicId: number | null): string {
  if (topicId) return `/topic/${topicId}`;
  if (wordPages.has(term)) return `/word/${encodeURIComponent(term)}`;
  return `/search?q=${encodeURIComponent(term)}`;
}

const people = politicians();
const totalSpeeches = people.reduce((sum, p) => sum + p.n_speeches, 0);
---

<Base
  title="国会タイムライン"
  description="国会会議録の発言を横断検索し、議員ごとの時系列と争点語の頻度推移で見られます。出典は国立国会図書館の国会会議録検索システムです。"
>
  <h1>国会で、誰が何を言ったか</h1>
  <p class="lede">
    国会会議録の発言を、<strong>語から</strong>・<strong>議員から</strong>・
    <strong>全文検索から</strong>たどれます。
    数字は出しますが、評価も採点もしません。判断の材料を出すだけのサイトです。
  </p>

  <section class="lead-section">
    <h2>いま国会で議論されていること</h2>
    <p class="small muted">
      {formatDate(latest.from)}〜{formatDate(latest.until)}の
      {latest.sitting_days}開催日・{formatNumber(latest.n_speeches)}発言のうち、
      ふだんより急に増えた語です。
      <strong>出てくるのは主に審議中の法案の専門用語</strong>で、
      「今週の争点」ではありません。何が審議されているかの目印として見てください。
    </p>
    <ul class="chips">
      {terms.map((term) => (
        <li>
          <a class="chip" href={termHref(term.term, term.topic_id)}>
            {term.term}<span class="muted small"> {term.n}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>争点語から見る</h2>
    <p class="small muted">
      <strong>運営が選んだ{topicCount}語</strong>です。
      <strong>いつ議論されたかの推移</strong>と<strong>会派ごとの使われ方</strong>を
      見られます。選んだこと自体に判断が入っているので、網羅ではありません。
    </p>
    <ul class="chips">
      {topics.map((topic) => (
        <li><a class="chip" href={`/topic/${topic.id}`}>{topic.term}</a></li>
      ))}
      <li><a class="chip" href="/topics">すべて見る →</a></li>
    </ul>
  </section>

  <section>
    <h2>頻出語から見る</h2>
    <p class="small muted">
      こちらは<strong>運営が語を選んでいません</strong>。会議録に出てくる語を機械的に数え、
      ある時期に集中して使われた順に並べた{freq.words.length}語です。
      上の争点語とは別のもので、どちらが重要かという意味は含みません。
      <strong>国会の会期で絞る</strong>と、その会期でいつもより多く出た語が並びます。
    </p>
    <ul class="chips">
      {recent.map((word) => (
        <li>
          <a class="chip" href={termHref(word.term, word.topic_id)}>
            {word.term}<span class="muted small"> {word.peak.slice(0, 4)}年</span>
          </a>
        </li>
      ))}
      <li><a class="chip" href="/frequent">すべて見る →</a></li>
    </ul>
  </section>

  <section>
    <h2>語を指定して探す</h2>
    <p class="small muted">
      上の一覧に無い語も引けます。議員・会議名・年でも絞り込めます。
      <strong>検索語はどこにも送られません</strong>
      —— 照合はブラウザの中で完結します（<a href="/privacy">プライバシーポリシー</a>）。
    </p>
    <form class="site-search" action="/search" method="get">
      <label class="sr-only" for="q">キーワード</label>
      <input type="search" id="q" name="q" placeholder="例: 安全保障、選択的夫婦別姓、年金"
             enterkeyhint="search" autocomplete="off" />
      <button type="submit" class="primary">検索</button>
    </form>
  </section>

  <section>
    <h2>議員から見る</h2>
    <p class="small muted">
      {formatNumber(people.length)}人ぶんの発言を、新しい順に並べて読めます。
      所属会派の変遷も出します。
      <strong>発言数で議員を並べることはしません</strong>
      —— 発言数は委員会の所属と役職で決まるもので、活動量の指標にはならないためです。
    </p>
    <p><a class="chip" href="/politicians">議員の一覧 →</a></p>
  </section>

  <section>
    <h2>収録しているもの</h2>
    <dl class="figures">
      <div><dt>発言</dt><dd>{formatNumber(totalSpeeches)}件</dd></div>
      <div><dt>議員</dt><dd>{formatNumber(people.length)}人</dd></div>
      <div><dt>期間</dt><dd>2021年1月〜{t.through.slice(0, 4)}年{Number(t.through.slice(5, 7))}月</dd></div>
    </dl>
    <p class="small muted">
      発言数は名寄せできた議員のぶんです。参考人・政府参考人の発言もデータには持っていますが、
      検索の対象は議員の発言に限っています。
    </p>
  </section>

  <style>
    /* `.sr-only` / `.figures` / `.chips` は Base.astro の共通定義 */
    .lede { font-size: 1.12rem; max-width: 40rem; line-height: 1.85; }

    section { margin-block: 2.75rem; }

    /* 最初の節だけ間を詰める。ここが「いま何が議論されているか」の入口で、
       スクロールせずに見えている必要がある。
       淡い面を敷いてあるのは**装飾**で、重要度の表明ではない
       （何を主機能とみなしているかは節の順序で表している。site/README.md） */
    .lead-section {
      margin-top: 1.75rem;
      background: var(--tint-warm);
      border-radius: var(--radius);
      padding: 0.1rem 1.25rem 1.1rem;
    }
    /* 面を敷いたぶん、見出しの上マージンが箱の中で効いてしまう（親に padding が
       あるとマージンが相殺されない）。中の1つめだけ詰める */
    .lead-section h2 { margin-top: 1.1rem; }

    .site-search { display: flex; gap: 0.5rem; margin: 0.85rem 0; max-width: 34rem; }
    .site-search input { flex: 1; font-size: 1.05rem; padding-block: 0.6rem; }
    .site-search button { padding-inline: 1.25rem; }
  </style>
</Base>
