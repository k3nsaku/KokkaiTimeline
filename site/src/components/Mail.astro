---
/**
 * 連絡先メールの表示（`/disclaimer` と `/privacy` で使う）。
 *
 * **アドレスをそのままHTMLに置かない。** ユーザ名とドメインを別々の属性に分け、
 * 画面には全角の＠で出す。単純な収集ボットは `\S+@\S+` を拾うだけなので、
 * これで大半は外れる。
 *
 * ただし**窓口としての使いやすさを落とさない**（訂正依頼を受け取れることが
 * docs/SCOPE.md の目的なので、読めるだけで送れない表示は本末転倒）。
 * そこでコピーボタンだけJSで組み立てる。JSが動かなくても、
 * ＠を半角に直せば読める形が残る。
 */
import { OPERATOR, mailParts } from "../lib/operator";

const mail = OPERATOR.email ? mailParts(OPERATOR.email) : null;
---

{mail ? (
  <p class="mail-line">
    <span class="mail" data-user={mail.user} data-domain={mail.domain}>
      {mail.user}<span aria-hidden="true"> ＠ </span>{mail.domain}
    </span>
    <span class="muted small">（＠は半角の @ に直して送ってほしい）</span>
  </p>
) : (
  <p class="todo small">
    ⚠ 連絡先が未記入（<code>src/lib/operator.ts</code> の <code>email</code>）。
    <strong>ここが埋まるまで公開しない。</strong>
  </p>
)}

<script>
  // ボタンはJSで作る。動かない環境に押せないボタンを残さないため
  for (const el of document.querySelectorAll<HTMLElement>(".mail[data-user]")) {
    const { user, domain } = el.dataset;
    if (!user || !domain || !navigator.clipboard) continue;

    const button = document.createElement("button");
    button.type = "button";
    button.className = "mail-copy";
    button.textContent = "コピー";
    button.addEventListener("click", async () => {
      // 権限が下りないブラウザがある。黙って何も起きないのがいちばん困るので、
      // 失敗したことを出して、テキストの表示から手で拾ってもらう
      try {
        await navigator.clipboard.writeText(`${user}@${domain}`);
        button.textContent = "コピーした";
      } catch {
        button.textContent = "コピーできなかった";
      }
      setTimeout(() => { button.textContent = "コピー"; }, 2000);
    });
    el.after(button);
  }
</script>

<style is:global>
  /* ボタンを後から差し込むので、スコープ付きスタイルだと当たらない */
  .mail-line { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .mail {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    user-select: all;
  }
  .mail-copy { font-size: 0.8rem; padding: 0.2rem 0.6rem; }
</style>
