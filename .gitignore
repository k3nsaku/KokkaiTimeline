# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 取得した生データ・生成物（リポジトリには入れない）
# 手書きの資産（party_map / party_overrides / politician_ids / topics）は
# 除外していない。生成物ではないので必ずコミットすること
data/raw/
data/dist/
data/politicians.json
data/words.json
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3
reports/

# プロトタイプ（検証用。配布物は vendor.js で再生成できる）
node_modules/
prototype/public/vendor/

# サイト（site/.gitignore にも同じものを置いてある）
site/dist/
site/.astro/
site/public/vendor/
site/.env

# wrangler のローカル状態（Pages へ手で上げたときにできる）
.wrangler/

# Claude Code のローカル設定（launch.json は共有したいのでコミットする）
.claude/settings.local.json

# 運営作業の実施記録（この端末だけのもの）。
# 作業一覧と推奨間隔は CLAUDE.md 側にあるので、これを失っても日付だけの損失で済む
OPERATIONS.local.md

# OS / エディタ
.DS_Store
Thumbs.db
.vscode/
.idea/
